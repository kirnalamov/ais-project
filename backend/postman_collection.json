          "name": "Project graph (critical path)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis/projects/1/graph",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analysis",
                "projects",
                "1",
                "graph"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
